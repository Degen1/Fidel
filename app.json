{
  "expo": {
    "name": "Fidel",
    "slug": "fidel",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fidel",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.degengebre.fidel",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.degengebre.fidel"
    },
    "androidStatusBar": {
      "backgroundColor": "#00000000",
      "translucent": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/AbyssinicaSIL-Regular.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "AbyssinicaSIL",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/AbyssinicaSIL-Regular.ttf",
                    "weight": 100
                  },
                  {
                    "path": "./assets/fonts/AbyssinicaSIL-Regular.ttf",
                    "weight": 200
                  },
                  {
                    "path": "./assets/fonts/AbyssinicaSIL-Regular.ttf",
                    "weight": 300
                  },
                  {
                    "path": "./assets/fonts/AbyssinicaSIL-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/AbyssinicaSIL-Regular.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/AbyssinicaSIL-Regular.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/AbyssinicaSIL-Regular.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/AbyssinicaSIL-Regular.ttf",
                    "weight": 800
                  },
                  {
                    "path": "./assets/fonts/AbyssinicaSIL-Regular.ttf",
                    "weight": 900
                  }
                ]
              }
            ]
          }
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "849e6ac5-511c-4b6b-9053-ddabc04d57f7"
      }
    }
  }
}
